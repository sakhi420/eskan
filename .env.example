# Local development (matches docker-compose.yml: user `eskan`, password `eskan_dev_password`)
DATABASE_URL="postgresql://eskan:eskan_dev_password@localhost:5432/eskan_dev"
PORT=3000
NODE_ENV=development

# --- Auth (Phase 6) ---
# HS256 signing secret for access tokens (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="replace-with-a-64-char-random-hex-secret"
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=eskan-api
JWT_AUDIENCE=eskan-mobile
# Refresh token lifetime in days (default 30)
REFRESH_TTL_DAYS=30
# Whether self-service registration is allowed (default true)
REGISTRATION_ENABLED=true
# Trial subscription length in days (default 30)
TRIAL_DAYS=30

# Argon2id parameters (OWASP minimums)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Login throttling (in-memory)
LOGIN_THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=5