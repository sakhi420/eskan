{
  "name": "@eskan/backend",
  "version": "0.1.0",
  "description": "ESKAN backend — NestJS + TypeScript + Prisma + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "node scripts/run-jest.cjs",
    "test:watch": "node scripts/run-jest.cjs --watch",
    "test:e2e": "node scripts/run-jest.cjs --config ./test/jest-e2e.json --runInBand",
    "test:integration": "node scripts/run-jest.cjs --config ./test/jest-integration.json --runInBand",
    "test:migration": "node scripts/test-m1-migration.cjs",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.{ts,json,prisma}\"",
    "openapi:validate": "npx @redocly/cli@1.25.15 lint contracts/openapi.yaml",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "dotenv": "16.4.7",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@prisma/engines": "7.10.1",
    "prisma": "7.10.1",
    "@parcel/watcher": "2.6.0",
    "unrs-resolver": "1.12.2"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
